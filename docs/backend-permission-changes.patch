diff --git a/liteShop-user-service/src/main/java/org/hongtu/service/support/PermissionHierarchy.java b/liteShop-user-service/src/main/java/org/hongtu/service/support/PermissionHierarchy.java
index d3b7441..196708c 100644
--- a/liteShop-user-service/src/main/java/org/hongtu/service/support/PermissionHierarchy.java
+++ b/liteShop-user-service/src/main/java/org/hongtu/service/support/PermissionHierarchy.java
@@ -10,6 +10,24 @@ import java.util.stream.Collectors;
 /** Pure hierarchy validation and navigation ancestor resolution. */
 public final class PermissionHierarchy {
     private PermissionHierarchy() {}
+    /** Selecting an action includes its page; selecting a page never includes its actions. */
+    public static List<Long> assignment(List<SysPermission> available, List<Long> selected) {
+        Map<Long, SysPermission> byId = available.stream().collect(Collectors.toMap(SysPermission::getId, p -> p));
+        Set<Long> result = new LinkedHashSet<>();
+        for (Long id : selected) {
+            Set<Long> visited = new HashSet<>();
+            Long cursor = id;
+            while (cursor != null && cursor != 0L) {
+                SysPermission node = byId.get(cursor);
+                if (node == null || node.getStatus() != StatusEnum.NORMAL || !visited.add(cursor))
+                    throw new IllegalArgumentException("权限或上级菜单不可分配，请刷新后重试");
+                result.add(cursor);
+                cursor = node.getParentId();
+            }
+            if (id == null || id == 0L) throw new IllegalArgumentException("权限ID不能为空");
+        }
+        return new ArrayList<>(result);
+    }
     public static boolean isDirectory(SysPermission row) {
         return row.getPermissionType() == PermissionTypeEnum.MENU
                 && Set.of("Layout", "/index/index", "index/index", "index/index.vue")
diff --git a/liteShop-user-service/src/test/java/org/hongtu/service/impl/PermissionAssignmentTest.java b/liteShop-user-service/src/test/java/org/hongtu/service/impl/PermissionAssignmentTest.java
index e69de29..f4800b3 100644
--- /dev/null
+++ b/liteShop-user-service/src/test/java/org/hongtu/service/impl/PermissionAssignmentTest.java
@@ -0,0 +1,34 @@
+package org.hongtu.service.impl;
+
+import org.hongtu.DTO.SysPermission;
+import org.hongtu.enums.PermissionTypeEnum;
+import org.hongtu.enums.StatusEnum;
+import org.hongtu.service.support.PermissionHierarchy;
+import org.junit.jupiter.api.Test;
+import java.util.List;
+import static org.junit.jupiter.api.Assertions.*;
+
+class PermissionAssignmentTest {
+    private SysPermission row(long id, long parent, PermissionTypeEnum type) {
+        return new SysPermission().setId(id).setParentId(parent).setPermissionType(type).setStatus(StatusEnum.NORMAL);
+    }
+    private List<SysPermission> tree() {
+        return List.of(row(1, 0, PermissionTypeEnum.MENU), row(2, 1, PermissionTypeEnum.MENU),
+                row(3, 2, PermissionTypeEnum.BUTTON), row(4, 2, PermissionTypeEnum.BUTTON));
+    }
+    @Test void pageSelectionDoesNotIncludeButtons() {
+        assertEquals(List.of(2L, 1L), PermissionHierarchy.assignment(tree(), List.of(2L)));
+    }
+    @Test void actionSelectionIncludesOnlyItsAncestors() {
+        assertEquals(List.of(3L, 2L, 1L), PermissionHierarchy.assignment(tree(), List.of(3L)));
+    }
+    @Test void missingOrDisabledParentsCannotBecomeGranted() {
+        assertThrows(IllegalArgumentException.class, () -> PermissionHierarchy.assignment(tree(), List.of(99L)));
+        var nodes = tree(); nodes.get(1).setStatus(StatusEnum.DISABLED);
+        assertThrows(IllegalArgumentException.class, () -> PermissionHierarchy.assignment(nodes, List.of(3L)));
+    }
+    @Test void emptySelectionRevokesAllAndDuplicateSelectionIsIdempotent() {
+        assertEquals(List.of(), PermissionHierarchy.assignment(tree(), List.of()));
+        assertEquals(List.of(3L, 2L, 1L), PermissionHierarchy.assignment(tree(), List.of(3L, 3L)));
+    }
+}
diff --git a/liteShop-user-service/src/test/java/org/hongtu/service/OperationPermissionTest.java b/liteShop-user-service/src/test/java/org/hongtu/service/OperationPermissionTest.java
index e69de29..3790292 100644
--- /dev/null
+++ b/liteShop-user-service/src/test/java/org/hongtu/service/OperationPermissionTest.java
@@ -0,0 +1,79 @@
+package org.hongtu.service;
+
+import cn.dev33.satoken.SaManager;
+import cn.dev33.satoken.stp.StpInterface;
+import cn.dev33.satoken.stp.StpLogic;
+import cn.dev33.satoken.stp.StpUtil;
+import cn.dev33.satoken.strategy.SaAnnotationStrategy;
+import cn.dev33.satoken.exception.NotPermissionException;
+import org.hongtu.controller.*;
+import org.hongtu.security.OperationPermission;
+import org.junit.jupiter.api.*;
+import java.util.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OperationPermissionTest {
+    private StpInterface previous;
+    private StpLogic previousLogic;
+    private List<String> codes = List.of();
+    private List<String> roles = List.of("CUSTOM_MANAGER");
+
+    @BeforeEach void setUp() {
+        previous = SaManager.getStpInterface();
+        previousLogic = StpUtil.getStpLogic();
+        StpUtil.setStpLogic(new StpLogic("login") {
+            @Override public Object getLoginId() { return 42L; }
+        });
+        SaManager.setStpInterface(new StpInterface() {
+            public List<String> getPermissionList(Object id, String type) { return codes; }
+            public List<String> getRoleList(Object id, String type) { return roles; }
+        });
+    }
+    @AfterEach void tearDown() {
+        SaManager.setStpInterface(previous);
+        StpUtil.setStpLogic(previousLogic);
+    }
+    private void check(Class<?> controller, String name) {
+        var method = Arrays.stream(controller.getDeclaredMethods()).filter(m -> m.getName().equals(name)).findFirst().orElseThrow();
+        SaAnnotationStrategy.instance.checkMethodAnnotation.accept(method);
+    }
+    @Test void pagePermissionDoesNotGrantWriteOperations() {
+        codes = List.of("system:role", "system:user");
+        assertThrows(NotPermissionException.class, () -> check(SysRoleController.class, "addRole"));
+        assertThrows(NotPermissionException.class, () -> check(SysRoleController.class, "deleteRole"));
+        assertThrows(NotPermissionException.class, () -> check(SysRolePermissionController.class, "assignPermissions"));
+        assertThrows(NotPermissionException.class, () -> check(SysUserController.class, "rechargeBalance"));
+    }
+    @Test void arbitraryRoleCanUseOnlyItsGrantedOperation() {
+        codes = List.of("system:role:add");
+        assertDoesNotThrow(() -> check(SysRoleController.class, "addRole"));
+        assertThrows(NotPermissionException.class, () -> check(SysRoleController.class, "deleteRole"));
+    }
+    @Test void legacyAdminRoleDoesNotBypassOperationChecks() {
+        roles = List.of("ADMIN");
+        assertThrows(NotPermissionException.class, () -> check(SysUserController.class, "rechargeBalance"));
+    }
+    @Test void superAdminRetainsExplicitBypass() {
+        roles = List.of("SUPER_ADMIN");
+        assertDoesNotThrow(() -> check(SysRoleController.class, "deleteRole"));
+        assertDoesNotThrow(() -> OperationPermission.order("gift"));
+    }
+    @Test void revocationTakesEffectOnNextCheck() {
+        codes = List.of("system:user:reset-password");
+        check(SysUserController.class, "adminResetPassword");
+        codes = List.of();
+        assertThrows(NotPermissionException.class, () -> check(SysUserController.class, "adminResetPassword"));
+    }
+    @Test void compositeSensitiveFieldRequiresItsOwnPermission() {
+        codes = List.of("config:banner:edit");
+        assertDoesNotThrow(() -> OperationPermission.requireChange("config:banner:status", 1, 1));
+        assertDoesNotThrow(() -> OperationPermission.requireChange("config:banner:status", 1, null));
+        assertThrows(NotPermissionException.class, () -> OperationPermission.requireChange("config:banner:status", 1, 0));
+    }
+    @Test void cashierSettlementDoesNotGrantGiftOrRefund() {
+        codes = List.of("operations:direct-cashier:settle");
+        assertDoesNotThrow(() -> OperationPermission.order("settle"));
+        assertThrows(NotPermissionException.class, () -> OperationPermission.order("gift"));
+        assertThrows(NotPermissionException.class, () -> OperationPermission.order("refund"));
+    }
+}
